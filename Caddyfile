{$DOMAIN:localhost} {
    {$CADDY_TLS:tls internal}

    # Auto-inject gateway token when visiting / without ?token=
    # (exclude WebSocket upgrade — cannot follow 302)
    @needs_token {
        not query token=*
        not header Connection *Upgrade*
        path /
        method GET
    }
    redir @needs_token /?token={$OPENCLAW_GATEWAY_TOKEN} 302

    reverse_proxy openclaw:18789
}
